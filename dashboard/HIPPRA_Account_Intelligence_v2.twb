            <column caption="Enrichment Coverage" datatype="string" name="[Calculation_EnrichmentStatus]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [has_targeted_enrichment] THEN &quot;Enriched&quot; ELSE &quot;Not Enriched&quot; END" />
